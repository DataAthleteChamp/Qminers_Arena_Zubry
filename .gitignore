# Share Round 1 losslessly compressed; keep the oversized working CSV local.
/data/round1/round1.csv

# Round2 raw inputs/trials remain local; share only the registered public archive.
/data/round2/*
!/data/round2/.gitkeep
!/data/round2/round2_public.csv.gz
!/data/round2/round2_public_manifest.json
!/data/round2/round2_public.sha256
/data/round2/round2_public.csv
# Round3 working tape stays local; registration and provenance are separate.
/data/round3/round3_public.csv
/experiments/
